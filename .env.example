# Devin (Settings > Service Users in the Devin app)
DEVIN_API_KEY=cog_xxxxxxxxxxxx
DEVIN_ORG_ID=your_org_id

# GitHub fine-grained PAT with Issues:read-write on the superset fork
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_REPO=your-org/superset

# Secret configured on the GitHub webhook (leave empty to disable verification locally)
WEBHOOK_SECRET=change-me

# Optional overrides
TRIGGER_LABEL=devin-remediate
HUMAN_LABEL=needs-human
POLL_INTERVAL_SECONDS=30
DB_PATH=/data/state.db
